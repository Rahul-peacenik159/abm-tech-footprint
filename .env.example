# Copy to .env (never commit .env)

# Optional: higher PageSpeed Insights quota. Create a free key in Google Cloud:
# APIs & Services > Credentials > Create API key, then enable "PageSpeed Insights API".
PAGESPEED_API_KEY=

# Optional: identify your scans politely (include a contact URL or email)
# FOOTPRINT_USER_AGENT=abm-tech-footprint/0.1 (+https://yourcompany.com)

# Optional: request timeout in seconds (default 20)
# FOOTPRINT_TIMEOUT=20

# Optional: DNS-over-HTTPS endpoint used when dnspython is not installed
# FOOTPRINT_DOH_URL=https://dns.google/resolve
